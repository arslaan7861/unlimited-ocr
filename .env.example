# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Unlimited-OCR Model Settings
# Path to local directory or Hugging Face repo ID
MODEL_PATH=models/unlimited-ocr
DEVICE=cpu
TORCH_DTYPE=bfloat16

# Processing & Safety Constraints
